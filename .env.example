POSTGRES_DB=strengthplanner
# Superkorisnički nalog — koristi ga samo postgres imidž pri prvom pokretanju.
POSTGRES_USER=strengthplanner
POSTGRES_PASSWORD=change-me-local-password

# Nalog kojim se APLIKACIJA povezuje. Nije superkorisnik: čita i piše podatke, ali ne
# može van svoje baze. Pravi ga db/init/01-app-role.sh pri prvom pokretanju.
APP_DB_USER=strengthplanner_app
APP_DB_PASSWORD=change-me-app-password

ASPNETCORE_ENVIRONMENT=Production
# API se objavljuje samo na petlji; spolja se do njega dolazi kroz nginx (web servis).
API_PORT=5000
WEB_PORT=8080

JWT_ISSUER=StrengthPlanner
JWT_AUDIENCE=StrengthPlanner.Client
# Min. 32 bajta. Napravi nasumičan ključ, npr:
#   openssl rand -base64 48
JWT_KEY=replace-with-at-least-32-characters-for-local-demo
JWT_EXPIRY_MINUTES=60
