POSTGRES_DB=strengthplanner
# Superkorisnički nalog — koristi ga samo postgres imidž pri prvom pokretanju.
POSTGRES_USER=strengthplanner
POSTGRES_PASSWORD=change-me-local-password

# Nalog kojim se APLIKACIJA povezuje. Nije superkorisnik: čita i piše podatke, ali ne
# može van svoje baze. Pravi ga db/init/01-app-role.sh pri prvom pokretanju.
APP_DB_USER=strengthplanner_app
APP_DB_PASSWORD=change-me-app-password

ASPNETCORE_ENVIRONMENT=Production
# API i web se objavljuju samo na petlji. Na serveru se aplikaciji pristupa kroz Caddy
# (docker-compose.tls.yml), koji jedini objavljuje portove spolja.
API_PORT=5000
WEB_PORT=8080

JWT_ISSUER=StrengthPlanner
JWT_AUDIENCE=StrengthPlanner.Client
# Min. 32 bajta. Napravi nasumičan ključ, npr:
#   openssl rand -base64 48
JWT_KEY=replace-with-at-least-32-characters-for-local-demo
JWT_EXPIRY_MINUTES=60
# Koliko dana prijava traje ako se aplikacija ne otvara. Svako otvaranje je produži.
# Politika privatnosti navodi 30 dana: ako ovo menjaš, izmeni i nju.
JWT_REFRESH_EXPIRY_DAYS=30

# --- Politika privatnosti (obavezno uz docker-compose.tls.yml) ---
# Ime i prezime (ili firma) onoga ko odgovara za podatke korisnika i adresa na koju se pišu
# pitanja i zahtevi. Oboje je javno na stranici /privacy.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=

# --- TLS (samo uz docker-compose.tls.yml) ---
# Domen mora da pokazuje na ovu mašinu, a portovi 80 i 443 da budu dostupni sa interneta;
# to su uslovi koje Let's Encrypt proverava.
#
#   APP_DOMAIN=tvoj-domen.rs TLS_EMAIL=ti@primer.com \
#   PRIVACY_CONTROLLER_NAME="Ime Prezime" PRIVACY_CONTACT_EMAIL=ti@primer.com \
#     docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d
#
# Traži Docker Compose v2.24 ili noviji.
#
# Na serveru otkomentariši sledeći red, da bi svaka `docker compose` naredba koristila oba
# fajla. Lokalno ga ostavi zakomentarisanog (TLS varijanta traži domen). Na Linux-u se fajlovi
# razdvajaju dvotačkom, na Windows-u tačka-zarezom.
# COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
APP_DOMAIN=
# Adresa na koju Let's Encrypt šalje obaveštenja o isteku sertifikata.
TLS_EMAIL=

# --- Rezervne kopije (samo uz docker-compose.backup.yml) ---
# Na serveru se fajl dodaje na kraj reda COMPOSE_FILE:
# COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml:docker-compose.backup.yml
# Skladište van servera. Podešavanje: docs/deployment-security.md, „Rezervne kopije“.
RESTIC_REPOSITORY=sftp:storagebox:strengthplanner
# Lozinka kojom su kopije šifrovane (npr. `openssl rand -base64 32`). Bez nje se ne mogu
# pročitati: čuvaj je i van servera.
RESTIC_PASSWORD=
# Sat noćne kopije, po UTC.
BACKUP_HOUR=2
# Neobavezno: adresa spoljnog nadzora koja se poziva posle uspešne kopije, dok je servis zdrav.
BACKUP_PING_URL=
# Samo za S3 skladište:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Security__RequireHttps i Security__ProxyCount postavlja sam docker-compose.tls.yml —
# ovde ih ne treba dirati. Bez TLS-a moraju da ostanu isključeni: preusmeravanje bez
# proxy-ja ispred pravi petlju.
