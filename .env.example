POSTGRES_DB=strengthplanner
# Superkorisnički nalog — koristi ga samo postgres imidž pri prvom pokretanju.
POSTGRES_USER=strengthplanner
POSTGRES_PASSWORD=change-me-local-password

# Nalog kojim se APLIKACIJA povezuje. Nije superkorisnik: čita i piše podatke, ali ne
# može van svoje baze. Pravi ga db/init/01-app-role.sh pri prvom pokretanju.
APP_DB_USER=strengthplanner_app
APP_DB_PASSWORD=change-me-app-password

ASPNETCORE_ENVIRONMENT=Production
# API se objavljuje samo na petlji; spolja se do njega dolazi kroz nginx (web servis).
API_PORT=5000
WEB_PORT=8080

JWT_ISSUER=StrengthPlanner
JWT_AUDIENCE=StrengthPlanner.Client
# Min. 32 bajta. Napravi nasumičan ključ, npr:
#   openssl rand -base64 48
JWT_KEY=replace-with-at-least-32-characters-for-local-demo
JWT_EXPIRY_MINUTES=60

# --- TLS (samo uz docker-compose.tls.yml) ---
# Domen mora da pokazuje na ovu mašinu, a portovi 80 i 443 da budu dostupni sa interneta;
# to su uslovi koje Let's Encrypt proverava.
#
#   APP_DOMAIN=tvoj-domen.rs TLS_EMAIL=ti@primer.com \
#     docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d
#
# Traži Docker Compose v2.24 ili noviji.
APP_DOMAIN=
# Adresa na koju Let's Encrypt šalje obaveštenja o isteku sertifikata.
TLS_EMAIL=

# Security__RequireHttps i Security__ProxyCount postavlja sam docker-compose.tls.yml —
# ovde ih ne treba dirati. Bez TLS-a moraju da ostanu isključeni: preusmeravanje bez
# proxy-ja ispred pravi petlju.
